        </div>

        <!-- Session Logs & History Section -->
        <div class="ms-card rounded-xl p-5 space-y-4 shadow-md">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-300/30 pb-3 gap-2">
                <div class="flex items-center gap-2">
                    <h3 class="text-sm font-bold font-header flex items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left text-pink-500"></i> Grind Session History Log
                    </h3>
                    <span id="sessionCountBadge" class="text-xs font-mono px-2 py-0.5 rounded ms-inner-box font-bold">0 Saved Sessions</span>
                </div>
                <div class="flex items-center gap-3 text-xs">
                    <span class="theme-subtext">Lifetime Avg Meso/Min: <strong id="avgMesoHrText" class="text-pink-500 font-mono">0</strong></span>
                    <button onclick="clearAllHistory()" class="text-rose-500 hover:underline text-xs flex items-center gap-1 font-semibold">
                        <i class="fa-solid fa-trash-can"></i> Clear History
                    </button>
                </div>
            </div>

            <!-- History Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs font-mono">
                    <thead class="theme-subtext uppercase text-[11px] border-b border-slate-300/30">
                        <tr>
                            <th class="py-2.5 px-3">Date & Time</th>
                            <th class="py-2.5 px-3">Map & Lv</th>
                            <th class="py-2.5 px-3">Duration</th>
                            <th class="py-2.5 px-3">EXP Gained</th>
                            <th class="py-2.5 px-3">Net Profit</th>
                            <th class="py-2.5 px-3">Net Rate / Min</th>
                            <th class="py-2.5 px-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody" class="divide-y divide-slate-300/20">
                        <!-- Dynamic history items -->
                        <tr>
                            <td colspan="7" class="py-8 text-center theme-subtext italic font-sans">No grind sessions logged yet. Start the timer and click Finish & Save!</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="max-w-7xl mx-auto w-full mt-8 pt-4 border-t border-slate-400/30 flex flex-col md:flex-row items-center justify-between text-xs theme-subtext gap-2 font-medium">
        <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-pink-400"></span>
            <span>MapleStory Grind Session Tracker & Profit Calculator • Saved to LocalStorage</span>
        </div>
        <div>
            Happy Grinding! ♥
        </div>
    </footer>

    <!-- Toast Notification Overlay -->
    <div id="toast" class="fixed bottom-5 right-5 ms-glass text-xs font-semibold px-4 py-3 rounded-xl shadow-2xl transition-all duration-300 transform translate-y-20 opacity-0 pointer-events-none flex items-center gap-2 z-50">
        <i class="fa-solid fa-circle-info text-pink-500" id="toastIcon"></i>
        <span id="toastMessage">Notification message</span>
    </div>

    <script>
        // Default Common Consumables
        const DEFAULT_CONSUMABLES = [
        ];

        // Default Common Drops
        const DEFAULT_DROPS = [
        ];

        // App State
        let state = {
            timerRunning: false,
            startTime: null,
            elapsedSeconds: 0,
            targetSeconds: 0,
            timerInterval: null,
            mapName: 'Victoria Road',
            charLevel: 1,
            dropRate: 200,
            mesoRate: 100,
            startExp: 0.000,
            endExp: 0.000,
            mesoInputMode: 'diff',
            startMeso: 0,
            endMeso: 0,
            directMeso: 0,
            consumables: JSON.parse(JSON.stringify(DEFAULT_CONSUMABLES)),
            drops: JSON.parse(JSON.stringify(DEFAULT_DROPS)),
            history: [],
            currentTheme: 'maple-light'
        };

        window.onload = function() {
            loadSavedState();
            renderConsumables();
            renderDrops();
            renderHistory();
            updateCalculations();
            
            // Sync Location Dropdown / Custom input
            const mapSelect = document.getElementById('mapLocationSelect');
            const mapInput = document.getElementById('mapNameInput');
            
            let matchedOption = Array.from(mapSelect.options).find(opt => opt.value === state.mapName);
            if (matchedOption) {
                mapSelect.value = state.mapName;
                mapInput.classList.add('hidden');
                mapInput.value = state.mapName;
            } else {
                mapSelect.value = 'CUSTOM';
                mapInput.classList.remove('hidden');
                // Only keep state.mapName if it isn't one of the default options, otherwise leave blank for placeholder
                const isDefault = Array.from(mapSelect.options).some(opt => opt.value === state.mapName);
                mapInput.value = (state.mapName && !isDefault) ? state.mapName : '';
            }

            document.getElementById('charLevelInput').value = state.charLevel;
            document.getElementById('dropRateInput').value = state.dropRate;
            document.getElementById('mesoRateInput').value = state.mesoRate;
            document.getElementById('startExpInput').value = state.startExp;
            document.getElementById('endExpInput').value = state.endExp;
            document.getElementById('mesoInputMode').value = state.mesoInputMode;
            document.getElementById('startMesoInput').value = formatNumberWithCommas(state.startMeso);
            document.getElementById('endMesoInput').value = formatNumberWithCommas(state.endMeso);
            document.getElementById('directMesoInput').value = formatNumberWithCommas(state.directMeso);
            changeTheme(state.currentTheme || 'maple-light');

            toggleMesoInputMode();
            updateInputLockStates();
            
            if (state.timerRunning) {
                startTimerLoop();
            }
        };

        function handleLocationSelectChange(selectEl) {
            const customInput = document.getElementById('mapNameInput');
            if (selectEl.value === 'CUSTOM') {
                customInput.classList.remove('hidden');
                customInput.value = ''; // Clears the value completely so the placeholder shows
                customInput.focus();
                state.mapName = '';
            } else {
                customInput.classList.add('hidden');
                customInput.value = selectEl.value;
                state.mapName = selectEl.value;
            }
            saveCurrentState();
        }

        function changeTheme(themeName) {
            state.currentTheme = themeName;
            const bodyEl = document.getElementById('app-body');
            bodyEl.className = `theme-${themeName} min-h-screen flex flex-col justify-between p-3 md:p-6 select-none`;
            
            const selector = document.getElementById('theme-selector');
            if (selector) selector.value = themeName;

            saveCurrentState();
        }

        function toggleTimer() {
            if (state.timerRunning) {
                pauseTimer();
            } else {
                startTimer();
            }
        }

        function startTimer() {
            state.timerRunning = true;
            state.startTime = Date.now() - (state.elapsedSeconds * 1000);
            startTimerLoop();
            updateTimerUI();
            updateInputLockStates();
            showToast("Session timer started! Starting values locked in.", "success");
            saveCurrentState();
        }

        function pauseTimer() {
            state.timerRunning = false;
            clearInterval(state.timerInterval);
            updateTimerUI();
            updateInputLockStates();
            showToast("Session paused. Current/Ending values unlocked for entry!", "info");
            saveCurrentState();
        }

        function startTimerLoop() {
            clearInterval(state.timerInterval);
            state.timerInterval = setInterval(() => {
                const now = Date.now();
                state.elapsedSeconds = Math.floor((now - state.startTime) / 1000);
                updateTimerUI();
                updateCalculations();
            }, 1000);
        }

        function resetTimerOnly() {
            pauseTimer();
            state.elapsedSeconds = 0;
            state.targetSeconds = 0;
            updateTimerUI();
            updateCalculations();
            showToast("Timer reset to 00:00:00", "info");
            saveCurrentState();
        }

        function setTimerPreset(minutes) {
            state.targetSeconds = minutes * 60;
            updateTimerUI();
            showToast(`Timer target set to ${minutes} mins`, "info");
        }

        function updateTimerUI() {
            const timerDisplay = document.getElementById('timerDisplay');
            const statusDot = document.getElementById('timerStatusDot');
            const statusText = document.getElementById('timerStatusText');
            const startPauseBtn = document.getElementById('startPauseBtn');
            const startPauseIcon = document.getElementById('startPauseIcon');
            const startPauseLabel = document.getElementById('startPauseLabel');
            const elapsedTotalText = document.getElementById('elapsedTotalText');

            timerDisplay.textContent = formatSecondsToHHMMSS(state.elapsedSeconds);
            elapsedTotalText.textContent = `${state.elapsedSeconds}s`;

            if (state.timerRunning) {
                statusDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse";
                statusText.textContent = "Active";
                startPauseBtn.className = "w-full py-3 px-4 rounded-xl font-bold text-sm bg-amber-500 hover:bg-amber-400 text-slate-950 transition shadow-lg flex items-center justify-center gap-2";
                startPauseIcon.className = "fa-solid fa-pause";
                startPauseLabel.textContent = "Pause Session";
            } else {
                statusDot.className = "w-2.5 h-2.5 rounded-full bg-slate-400";
                statusText.textContent = "Paused";
                startPauseBtn.className = "w-full py-3 px-4 rounded-xl font-bold text-sm bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-400 hover:to-rose-400 text-white transition shadow-lg flex items-center justify-center gap-2";
                startPauseIcon.className = "fa-solid fa-play";
                startPauseLabel.textContent = state.elapsedSeconds > 0 ? "Resume Session" : "Start Session";
            }
        }

        function updateInputLockStates() {
            const startExpInput = document.getElementById('startExpInput');
            const endExpInput = document.getElementById('endExpInput');
            const startMesoInput = document.getElementById('startMesoInput');
            const endMesoInput = document.getElementById('endMesoInput');
            const directMesoInput = document.getElementById('directMesoInput');
            const expHint = document.getElementById('expInputModeHint');

            if (state.timerRunning) {
                startExpInput.disabled = true;
                startExpInput.className = "w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono transition bg-emerald-500/10 border-2 border-emerald-500/50 text-emerald-500 font-semibold cursor-not-allowed";
                
                startMesoInput.disabled = true;
                startMesoInput.className = "w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono transition bg-emerald-500/10 border-2 border-emerald-500/50 text-emerald-500 font-semibold cursor-not-allowed";

                endExpInput.disabled = true;
                endExpInput.className = "w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono transition bg-slate-500/10 border border-slate-400/20 text-slate-400 cursor-not-allowed";
                endExpInput.placeholder = "Pause timer to enter current EXP";

                endMesoInput.disabled = true;
                endMesoInput.className = "w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono transition bg-slate-500/10 border border-slate-400/20 text-slate-400 cursor-not-allowed";

                directMesoInput.disabled = true;
                directMesoInput.className = "w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono transition bg-slate-500/10 border border-slate-400/20 text-slate-400 cursor-not-allowed";

                expHint.textContent = "● GRINDING ACTIVE (Starting Stats Locked)";
                expHint.className = "text-xs theme-subtext font-bold text-emerald-500 animate-pulse";
            } else {
                startExpInput.disabled = false;
                startExpInput.className = "w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono transition focus:outline-none focus:border-pink-500";

                startMesoInput.disabled = false;
                startMesoInput.className = "w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono transition focus:outline-none focus:border-pink-500";

                endExpInput.disabled = false;
                endExpInput.className = "w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono text-pink-500 font-bold focus:outline-none focus:border-pink-500 transition ring-2 ring-pink-500/40 bg-pink-500/5";
                endExpInput.placeholder = "e.g. 5.250";

                endMesoInput.disabled = false;
                endMesoInput.className = "w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono text-pink-500 font-bold focus:outline-none focus:border-pink-500 transition ring-2 ring-pink-500/40 bg-pink-500/5";

                directMesoInput.disabled = false;
                directMesoInput.className = "w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono text-pink-500 font-bold focus:outline-none focus:border-pink-500 transition ring-2 ring-pink-500/40 bg-pink-500/5";

                expHint.textContent = "❚❚ PAUSED (Enter Current EXP & Mesos)";
                expHint.className = "text-xs theme-subtext font-bold text-amber-500";
            }
        }

        function updateCalculations() {
            let rawLevel = parseInt(document.getElementById('charLevelInput').value) || 1;
            if (rawLevel > 100) {
                rawLevel = 100;
                document.getElementById('charLevelInput').value = 100;
            } else if (rawLevel < 1) {
                rawLevel = 1;
                document.getElementById('charLevelInput').value = 1;
            }
            state.charLevel = rawLevel;

            let rawStartExp = parseFloat(document.getElementById('startExpInput').value) || 0;
            if (rawStartExp > 100) { rawStartExp = 100; document.getElementById('startExpInput').value = 100; }
            if (rawStartExp < 0) { rawStartExp = 0; document.getElementById('startExpInput').value = 0; }
            state.startExp = rawStartExp;

            let rawEndExp = parseFloat(document.getElementById('endExpInput').value) || 0;
            if (rawEndExp > 100) { rawEndExp = 100; document.getElementById('endExpInput').value = 100; }
            if (rawEndExp < 0) { rawEndExp = 0; document.getElementById('endExpInput').value = 0; }
            state.endExp = rawEndExp;

            document.getElementById('levelDisplayTag').textContent = `Lv. ${state.charLevel}`;

            let expGained = state.endExp - state.startExp;
            if (expGained < 0) expGained = 0;

            const effectiveSeconds = Math.max(state.elapsedSeconds, 10);
            const durationMinutes = effectiveSeconds / 60;

            const expPerMinute = expGained / durationMinutes;

            const remainingExp = 100 - state.endExp;
            let etaText = "--h --m";
            if (expPerMinute > 0 && remainingExp > 0) {
                const minutesNeeded = remainingExp / expPerMinute;
                const totalMinutes = Math.round(minutesNeeded);
                const hrs = Math.floor(totalMinutes / 60);
                const mins = totalMinutes % 60;
                etaText = `${hrs}h ${mins}m`;
            }

            document.getElementById('expGainedText').textContent = `+${expGained.toFixed(3)}%`;
            document.getElementById('expProgressBar').style.width = `${Math.min(100, Math.max(0, state.endExp))}%`;
            document.getElementById('expRateDisplay').textContent = `${expPerMinute.toFixed(3)}% / min`;
            document.getElementById('statTotalExp').textContent = `+${expGained.toFixed(3)}%`;
            document.getElementById('statExpPerHour').textContent = `${expPerMinute.toFixed(3)}% / min`;
            document.getElementById('etaToLevel').textContent = etaText;

            let grossMeso = 0;
            if (state.mesoInputMode === 'diff') {
                const startM = parseMesoInput(document.getElementById('startMesoInput').value);
                const endM = parseMesoInput(document.getElementById('endMesoInput').value);
                grossMeso = Math.max(0, endM - startM);
            } else {
                grossMeso = parseMesoInput(document.getElementById('directMesoInput').value);
            }

            const grossMesoPerMinute = grossMeso / durationMinutes;

            let totalConsumableCost = 0;
            state.consumables.forEach(item => {
                if (item.active) totalConsumableCost += (item.unitCost * item.qty);
            });

            let totalDropsValue = 0;
            state.drops.forEach(item => {
                totalDropsValue += (item.unitValue * item.qty);
            });

            const netProfit = (grossMeso + totalDropsValue) - totalConsumableCost;
            const netProfitPerMinute = netProfit / durationMinutes;

            document.getElementById('statGrossMeso').textContent = formatNumberWithCommas(grossMeso);
            document.getElementById('statMesoPerHour').textContent = `${formatShortMeso(grossMesoPerMinute)} / min`;
            document.getElementById('totalConsumableCostTag').textContent = `Total Cost: ${formatShortMeso(totalConsumableCost)} Meso`;
            document.getElementById('totalDropsValueTag').textContent = `Drops Value: ${formatShortMeso(totalDropsValue)} Meso`;

            const profitBannerCard = document.getElementById('profitBannerCard');
            const profitBadge = document.getElementById('profitBadge');
            const netProfitAmount = document.getElementById('netProfitAmount');
            const netProfitHourly = document.getElementById('netProfitHourly');

            const formattedNet = (netProfit >= 0 ? '+' : '') + formatNumberWithCommas(netProfit);
            const formattedNetMin = (netProfitPerMinute >= 0 ? '+' : '') + formatShortMeso(netProfitPerMinute) + ' / min';

            if (netProfit >= 0) {
                profitBannerCard.className = "ms-card rounded-xl p-4 flex flex-col justify-between relative overflow-hidden transition-all duration-300 shadow-md border-2 border-emerald-500/50";
                profitBadge.className = "px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 border border-emerald-300 flex items-center gap-1";
                profitBadge.innerHTML = `<i class="fa-solid fa-circle-check"></i> MESO POSITIVE`;
                netProfitAmount.className = "text-3xl font-extrabold font-mono text-emerald-500 tracking-tight";
            } else {
                profitBannerCard.className = "ms-card rounded-xl p-4 flex flex-col justify-between relative overflow-hidden transition-all duration-300 shadow-md border-2 border-rose-500/50";
                profitBadge.className = "px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-700 border border-rose-300 flex items-center gap-1";
                profitBadge.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> MESO NEGATIVE`;
                netProfitAmount.className = "text-3xl font-extrabold font-mono text-rose-500 tracking-tight";
            }

            netProfitAmount.innerHTML = `${formattedNet} <span class="text-xs font-normal opacity-70">mesos</span>`;
            netProfitHourly.textContent = formattedNetMin;
        }

        function renderConsumables() {
            const listEl = document.getElementById('consumablesList');
            listEl.innerHTML = '';

            state.consumables.forEach((item, index) => {
                const row = document.createElement('div');
                row.className = `flex items-center justify-between p-2 rounded-lg border transition ${item.active ? 'ms-inner-box' : 'opacity-60 ms-card'}`;
                
                row.innerHTML = `
                    <div class="flex items-center gap-2 max-w-[60%]">
                        <input type="checkbox" ${item.active ? 'checked' : ''} onchange="toggleConsumable(${index})" class="rounded border-slate-300 text-pink-500 focus:ring-0 cursor-pointer">
                        <span class="text-xs font-medium truncate" title="${item.name}">${item.name}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-1 ms-inner-box px-1.5 py-0.5 rounded">
                            <span class="text-[10px] theme-subtext">x</span>
                            <input type="number" value="${item.qty}" min="1" onchange="updateConsumableQty(${index}, this.value)" class="w-10 bg-transparent text-xs font-mono text-center focus:outline-none">
                        </div>
                        <div class="text-xs font-mono theme-subtext w-20 text-right truncate">
                            ${formatShortMeso(item.unitCost * item.qty)}
                        </div>
                        <button onclick="removeConsumable(${index})" class="theme-subtext hover:text-rose-500 transition text-xs px-1">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                `;
                listEl.appendChild(row);
            });
        }

        function toggleConsumable(index) {
            state.consumables[index].active = !state.consumables[index].active;
            renderConsumables();
            updateCalculations();
            saveCurrentState();
        }

        function updateConsumableQty(index, val) {
            state.consumables[index].qty = Math.max(1, parseInt(val) || 1);
            updateCalculations();
            saveCurrentState();
        }

        function removeConsumable(index) {
            state.consumables.splice(index, 1);
            renderConsumables();
            updateCalculations();
            saveCurrentState();
        }

        function addCustomConsumable() {
            const nameInput = document.getElementById('customConsumableName');
            const qtyInput = document.getElementById('customConsumableQty');
            const costInput = document.getElementById('customConsumableCost');

            const name = nameInput.value.trim();
            const qty = parseInt(qtyInput.value) || 1;
            const cost = parseMesoInput(costInput.value);

            if (!name) {
                showToast("Please enter an item name", "error");
                return;
            }

            state.consumables.push({
                id: 'custom_' + Date.now(),
                name: name,
                unitCost: cost,
                qty: qty,
                active: true
            });

            nameInput.value = '';
            costInput.value = '0';
            qtyInput.value = '1';

            renderConsumables();
            updateCalculations();
            showToast(`Added custom consumable: ${name}`, "success");
            saveCurrentState();
        }

        function renderDrops() {
            const listEl = document.getElementById('dropsList');
            listEl.innerHTML = '';

            state.drops.forEach((item, index) => {
                const row = document.createElement('div');
                row.className = "flex items-center justify-between p-2 rounded-lg ms-inner-box transition";
                
                row.innerHTML = `
                    <div class="flex items-center gap-2 max-w-[55%]">
                        <i class="fa-solid fa-angles-right text-[10px] text-purple-500"></i>
                        <span class="text-xs font-medium truncate" title="${item.name}">${item.name}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-1 ms-card px-1.5 py-0.5 rounded">
                            <span class="text-[10px] theme-subtext">Qty:</span>
                            <input type="number" value="${item.qty}" min="0" onchange="updateDropQty(${index}, this.value)" class="w-10 bg-transparent text-xs font-mono text-center focus:outline-none">
                        </div>
                        <div class="text-xs font-mono text-purple-600 font-bold w-20 text-right truncate">
                            +${formatShortMeso(item.unitValue * item.qty)}
                        </div>
                        <button onclick="removeDrop(${index})" class="theme-subtext hover:text-rose-500 transition text-xs px-1">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                `;
                listEl.appendChild(row);
            });
        }

        function updateDropQty(index, val) {
            state.drops[index].qty = Math.max(0, parseInt(val) || 0);
            renderDrops();
            updateCalculations();
            saveCurrentState();
        }

        function removeDrop(index) {
            state.drops.splice(index, 1);
            renderDrops();
            updateCalculations();
            saveCurrentState();
        }

        function addCustomDrop() {
            const nameInput = document.getElementById('customDropName');
            const qtyInput = document.getElementById('customDropQty');
            const valInput = document.getElementById('customDropValue');

            const name = nameInput.value.trim();
            const qty = parseInt(qtyInput.value) || 1;
            const unitVal = parseMesoInput(valInput.value);

            if (!name) {
                showToast("Please enter a drop item name", "error");
                return;
            }

            state.drops.push({
                id: 'drop_' + Date.now(),
                name: name,
                unitValue: unitVal,
                qty: qty
            });

            nameInput.value = '';
            valInput.value = '0';
            qtyInput.value = '1';

            renderDrops();
            updateCalculations();
            showToast(`Added custom drop: ${name}`, "success");
            saveCurrentState();
        }

        function stopAndSaveSession() {
            if (state.elapsedSeconds < 1) {
                showToast("Session duration is too short to save (min 1s)", "error");
                return;
            }

            pauseTimer();

            const mapName = document.getElementById('mapNameInput').value.trim() || 'Unknown Map';
            const charLv = parseInt(document.getElementById('charLevelInput').value) || 1;
            const expGained = Math.max(0, state.endExp - state.startExp);
            const durationMinutes = state.elapsedSeconds / 60;

            let grossMeso = 0;
            if (state.mesoInputMode === 'diff') {
                const startM = parseMesoInput(document.getElementById('startMesoInput').value);
                const endM = parseMesoInput(document.getElementById('endMesoInput').value);
                grossMeso = Math.max(0, endM - startM);
            } else {
                grossMeso = parseMesoInput(document.getElementById('directMesoInput').value);
            }

            let totalConsumableCost = 0;
            state.consumables.forEach(item => { if (item.active) totalConsumableCost += (item.unitCost * item.qty); });

            let totalDropsValue = 0;
            state.drops.forEach(item => { totalDropsValue += (item.unitValue * item.qty); });

            const netProfit = (grossMeso + totalDropsValue) - totalConsumableCost;
            const netProfitPerMinute = netProfit / durationMinutes;

            const sessionEntry = {
                id: 'session_' + Date.now(),
                timestamp: new Date().toLocaleString(),
                mapName: mapName,
                level: charLv,
                durationSeconds: state.elapsedSeconds,
                expGained: expGained,
                netProfit: netProfit,
                netProfitPerMinute: netProfitPerMinute
            };

            state.history.unshift(sessionEntry);
            renderHistory();
            showToast("Session successfully saved to history!", "success");

            state.startExp = state.endExp;
            if (state.mesoInputMode === 'diff') {
                state.startMeso = parseMesoInput(document.getElementById('endMesoInput').value);
                document.getElementById('startMesoInput').value = formatNumberWithCommas(state.startMeso);
            }
            document.getElementById('startExpInput').value = state.startExp;

            state.elapsedSeconds = 0;
            updateTimerUI();
            updateCalculations();
            updateInputLockStates();
            saveCurrentState();
        }

        function renderHistory() {
            const tbody = document.getElementById('historyTableBody');
            const countBadge = document.getElementById('sessionCountBadge');
            const avgMesoHrText = document.getElementById('avgMesoHrText');

            countBadge.textContent = `${state.history.length} Saved Sessions`;

            if (state.history.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-8 text-center theme-subtext italic font-sans">No grind sessions logged yet. Start the timer and click Finish & Save!</td>
                    </tr>
                `;
                avgMesoHrText.textContent = "0";
                return;
            }

            tbody.innerHTML = '';
            let totalMesoMinSum = 0;

            state.history.forEach((session) => {
                totalMesoMinSum += session.netProfitPerMinute;

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-500/10 transition";

                const isPositive = session.netProfit >= 0;
                const profitClass = isPositive ? 'text-emerald-500' : 'text-rose-500';
                const sign = isPositive ? '+' : '';

                tr.innerHTML = `
                    <td class="py-2.5 px-3 theme-subtext text-[11px]">${session.timestamp}</td>
                    <td class="py-2.5 px-3 font-sans font-semibold">${session.mapName} <span class="text-xs text-pink-500">Lv.${session.level}</span></td>
                    <td class="py-2.5 px-3">${formatSecondsToHHMMSS(session.durationSeconds)}</td>
                    <td class="py-2.5 px-3 text-pink-500">+${session.expGained.toFixed(3)}%</td>
                    <td class="py-2.5 px-3 font-bold ${profitClass}">${sign}${formatShortMeso(session.netProfit)}</td>
                    <td class="py-2.5 px-3 font-bold ${profitClass}">${sign}${formatShortMeso(session.netProfitPerMinute)}/min</td>
                    <td class="py-2.5 px-3 text-right">
                        <button onclick="deleteHistoryItem('${session.id}')" class="theme-subtext hover:text-rose-500 transition">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            const avgMesoMin = totalMesoMinSum / state.history.length;
            avgMesoHrText.textContent = `${formatShortMeso(avgMesoMin)} / min`;
        }

        function deleteHistoryItem(id) {
            state.history = state.history.filter(item => item.id !== id);
            renderHistory();
            showToast("Log entry deleted", "info");
            saveCurrentState();
        }

        function clearAllHistory() {
            if (confirm("Are you sure you want to clear all session history?")) {
                state.history = [];
                renderHistory();
                showToast("Session history cleared", "info");
                saveCurrentState();
            }
        }

        function toggleMesoInputMode() {
            state.mesoInputMode = document.getElementById('mesoInputMode').value;
            const diffBox = document.getElementById('mesoDiffContainer');
            const directBox = document.getElementById('mesoDirectContainer');

            if (state.mesoInputMode === 'diff') {
                diffBox.classList.remove('hidden');
                directBox.classList.add('hidden');
            } else {
                diffBox.classList.add('hidden');
                directBox.classList.remove('hidden');
            }
            updateCalculations();
            saveCurrentState();
        }

        function formatMesoInput(inputEl) {
            const rawVal = parseMesoInput(inputEl.value);
            inputEl.value = formatNumberWithCommas(rawVal);
        }

        function parseMesoInput(str) {
            if (!str) return 0;
            const clean = str.toString().replace(/,/g, '').trim();
            return parseInt(clean, 10) || 0;
        }

        function formatNumberWithCommas(num) {
            return Math.round(num).toLocaleString('en-US');
        }

        function formatShortMeso(num) {
            const abs = Math.abs(num);
            const sign = num < 0 ? '-' : '';
            if (abs >= 1000000000) {
                return sign + (abs / 1000000000).toFixed(2) + 'B';
            } else if (abs >= 1000000) {
                return sign + (abs / 1000000).toFixed(2) + 'M';
            } else if (abs >= 1000) {
                return sign + (abs / 1000).toFixed(1) + 'K';
            }
            return sign + Math.round(abs).toLocaleString('en-US');
        }

        function formatSecondsToHHMMSS(totalSeconds) {
            const hrs = Math.floor(totalSeconds / 3600);
            const mins = Math.floor((totalSeconds % 3600) / 60);
            const secs = totalSeconds % 60;
            return [hrs, mins, secs].map(v => v < 10 ? "0" + v : v).join(":");
        }

        function saveCurrentState() {
            const mapSelect = document.getElementById('mapLocationSelect');
            const mapInput = document.getElementById('mapNameInput');
            if (mapSelect.value === 'CUSTOM') {
                state.mapName = mapInput.value;
            } else {
                state.mapName = mapSelect.value;
            }

            state.charLevel = parseInt(document.getElementById('charLevelInput').value) || 1;
            state.dropRate = parseFloat(document.getElementById('dropRateInput').value) || 0;
            state.mesoRate = parseFloat(document.getElementById('mesoRateInput').value) || 0;
            state.startExp = parseFloat(document.getElementById('startExpInput').value) || 0;
            state.endExp = parseFloat(document.getElementById('endExpInput').value) || 0;
            state.startMeso = parseMesoInput(document.getElementById('startMesoInput').value);
            state.endMeso = parseMesoInput(document.getElementById('endMesoInput').value);
            state.directMeso = parseMesoInput(document.getElementById('directMesoInput').value);

            localStorage.setItem('maple_grind_tracker_state_v2', JSON.stringify(state));
        }

        function loadSavedState() {
            const saved = localStorage.getItem('maple_grind_tracker_state_v2');
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    state = { ...state, ...parsed };
                } catch(e) {
                    console.error("Failed to parse saved state", e);
                }
            }
        }

        function resetCurrentSessionData() {
            if (confirm("Reset current session timer & input values? (History will be kept)")) {
                pauseTimer();
                state.elapsedSeconds = 0;
                state.startExp = 0.000;
                state.endExp = 0.000;
                state.startMeso = 0;
                state.endMeso = 0;
                state.directMeso = 0;

                document.getElementById('startExpInput').value = '0.000';
                document.getElementById('endExpInput').value = '0.000';
                document.getElementById('startMesoInput').value = '0';
                document.getElementById('endMesoInput').value = '0';
                document.getElementById('directMesoInput').value = '0';

                updateTimerUI();
                updateCalculations();
                updateInputLockStates();
                saveCurrentState();
                showToast("Session inputs reset", "info");
            }
        }

        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(state, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `maple_grind_session_data_${Date.now()}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
            showToast("Data exported as JSON file", "success");
        }

        function importData(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    state = { ...state, ...imported };
                    location.reload();
                } catch(err) {
                    showToast("Invalid JSON file", "error");
                }
            };
            reader.readAsText(file);
        }

        function showToast(msg, type = "info") {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.textContent = msg;

            if (type === "success") {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-500";
            } else if (type === "error") {
                toastIcon.className = "fa-solid fa-triangle-exclamation text-rose-500";
            } else {
                toastIcon.className = "fa-solid fa-circle-info text-pink-500";
            }

            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }
    </script>
</body>
</html>
