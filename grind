<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MapleStory Grind Tracker & Session Timer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        mono: ['"Share Tech Mono"', 'monospace'],
                        header: ['"Fredoka"', 'sans-serif'],
                        sans: ['"Inter"', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        /* Theme Palettes from Index */
        body.theme-dark {
            --bg-body-from: rgba(15, 20, 28, 0.8);
            --bg-body-to: rgba(13, 17, 23, 0.95);
            --bg-body-color: #0d1117;
            --text-main: #e2e8f0;
            --glass-bg: rgba(24, 32, 44, 0.85);
            --glass-border: rgba(255, 255, 255, 0.08);
            --card-bg: rgba(15, 23, 42, 0.6);
            --card-border: #1e293b;
            --accent-primary: #10b981;
            --accent-secondary: #06b6d4;
            --scrollbar-bg: #0f141c;
            --scrollbar-thumb: #2a3649;
            --scrollbar-thumb-hover: #3b4c66;
            --inner-bg: rgba(2, 6, 23, 0.8);
            --inner-border: rgba(30, 41, 59, 0.8);
            --subtext: #94a3b8;
        }

        body.theme-maple-light {
            --bg-body-from: #a2d2ff;
            --bg-body-to: #bde0fe;
            --bg-body-color: #bde0fe;
            --text-main: #4a2810;
            --glass-bg: #fffbf0;
            --glass-border: #8b5a2b;
            --card-bg: #fff8e7;
            --card-border: #734222;
            --accent-primary: #f43f5e;
            --accent-secondary: #f472b6;
            --scrollbar-bg: #bde0fe;
            --scrollbar-thumb: #8b5a2b;
            --scrollbar-thumb-hover: #5c3a19;
            --inner-bg: #fff2d6;
            --inner-border: #e6cb9e;
            --subtext: #8c5a3c;
        }

        body.theme-maple {
            --bg-body-from: rgba(40, 25, 15, 0.85);
            --bg-body-to: rgba(25, 15, 8, 0.95);
            --bg-body-color: #1a0f08;
            --text-main: #fef3c7;
            --glass-bg: rgba(54, 34, 20, 0.85);
            --glass-border: rgba(251, 191, 36, 0.2);
            --card-bg: rgba(43, 24, 12, 0.7);
            --card-border: #573216;
            --accent-primary: #f59e0b;
            --accent-secondary: #ea580c;
            --scrollbar-bg: #1a0f08;
            --scrollbar-thumb: #573216;
            --scrollbar-thumb-hover: #78441a;
            --inner-bg: rgba(15, 23, 42, 0.6);
            --inner-border: #573216;
            --subtext: #d97706;
        }

        body.theme-cyber {
            --bg-body-from: rgba(10, 5, 25, 0.9);
            --bg-body-to: rgba(5, 2, 15, 0.98);
            --bg-body-color: #05020f;
            --text-main: #f0abfc;
            --glass-bg: rgba(30, 10, 50, 0.85);
            --glass-border: rgba(217, 70, 239, 0.3);
            --card-bg: rgba(20, 8, 35, 0.8);
            --card-border: #4a1d70;
            --accent-primary: #d946ef;
            --accent-secondary: #38bdf8;
            --scrollbar-bg: #05020f;
            --scrollbar-thumb: #4a1d70;
            --scrollbar-thumb-hover: #701a75;
            --inner-bg: rgba(15, 23, 42, 0.6);
            --inner-border: #4a1d70;
            --subtext: #c084fc;
        }

        body.theme-crimson {
            --bg-body-from: rgba(25, 8, 8, 0.9);
            --bg-body-to: rgba(10, 3, 3, 0.98);
            --bg-body-color: #0a0303;
            --text-main: #fecdd3;
            --glass-bg: rgba(45, 12, 12, 0.85);
            --glass-border: rgba(244, 63, 94, 0.3);
            --card-bg: rgba(30, 8, 8, 0.8);
            --card-border: #5c1824;
            --accent-primary: #f43f5e;
            --accent-secondary: #fb923c;
            --scrollbar-bg: #0a0303;
            --scrollbar-thumb: #5c1824;
            --scrollbar-thumb-hover: #881337;
            --inner-bg: rgba(15, 23, 42, 0.6);
            --inner-border: #5c1824;
            --subtext: #f87171;
        }

        body.theme-moss {
            --bg-body-from: rgba(10, 22, 15, 0.9);
            --bg-body-to: rgba(5, 12, 8, 0.98);
            --bg-body-color: #050c08;
            --text-main: #d1fae5;
            --glass-bg: rgba(12, 35, 22, 0.85);
            --glass-border: rgba(52, 211, 153, 0.3);
            --card-bg: rgba(8, 25, 15, 0.8);
            --card-border: #14532d;
            --accent-primary: #34d399;
            --accent-secondary: #a3e635;
            --scrollbar-bg: #050c08;
            --scrollbar-thumb: #14532d;
            --scrollbar-thumb-hover: #166534;
            --inner-bg: rgba(15, 23, 42, 0.6);
            --inner-border: #14532d;
            --subtext: #34d399;
        }

        body {
            background-color: var(--bg-body-color);
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(255, 255, 255, 0.2) 0%, transparent 40%),
                radial-gradient(circle at 85% 85%, rgba(255, 255, 255, 0.15) 0%, transparent 40%),
                linear-gradient(to bottom, var(--bg-body-from), var(--bg-body-to));
            background-attachment: fixed;
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--scrollbar-bg);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--scrollbar-thumb);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--scrollbar-thumb-hover);
        }

        .ms-glass {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            border: 2px solid var(--glass-border);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
        }

        .ms-card {
            background: var(--card-bg);
            border: 2px solid var(--card-border);
        }

        .ms-inner-box {
            background: var(--inner-bg);
            border: 1px solid var(--inner-border);
        }

        .ms-button {
            transition: all 0.15s ease-in-out;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.3);
        }
        .ms-button:active {
            transform: translateY(1px);
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.2);
        }
        
        .theme-subtext {
            color: var(--subtext);
        }

        input[type=number]::-webkit-inner-spin-button, 
        input[type=number]::-webkit-outer-spin-button { 
            -webkit-appearance: none;
            margin: 0; 
        }
    </style>
</head>
<body id="app-body" class="theme-maple-light min-h-screen flex flex-col justify-between p-3 md:p-6 select-none">

    <div class="max-w-7xl mx-auto w-full space-y-6">
        <!-- Top Header Navigation -->
        <header class="ms-glass rounded-2xl p-4 md:p-6 shadow-2xl relative overflow-hidden">
            <div class="absolute -right-10 -top-10 w-40 h-40 bg-pink-400/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-sky-400/20 rounded-full blur-3xl pointer-events-none"></div>

            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 relative z-10">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 md:w-14 md:h-14 rounded-xl bg-gradient-to-br from-pink-400 to-rose-500 flex items-center justify-center text-white text-2xl md:text-3xl shadow-lg shadow-pink-500/30">
                        <i class="fa-solid font-bold fa-maple-leaf"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="font-header text-2xl md:text-3xl font-bold tracking-wide text-pink-500 drop-shadow-sm">
                                MS Classic Grind Session Tracker
                            </h1>
                            <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-pink-100 border border-pink-300 text-pink-700">
                                v2.5
                            </span>
                        </div>
                        <p class="text-xs md:text-sm theme-subtext mt-0.5 font-medium">
                            Session Tracker & Meso Profit Analyzer | By Sunshine ♥
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-2 flex-wrap">
                    <!-- Theme Selector Dropdown -->
                    <div class="flex items-center gap-1.5 ms-inner-box px-3 py-1.5 rounded-lg text-xs md:text-sm">
                        <i class="fa-solid fa-palette text-pink-500"></i>
                        <select id="theme-selector" onchange="changeTheme(this.value)" class="bg-transparent font-bold focus:outline-none cursor-pointer">
                            <option value="maple-light" class="bg-amber-50 text-pink-600">Default Maple Light</option>
                            <option value="dark" class="bg-slate-900 text-slate-200">Default Dark</option>
                            <option value="maple" class="bg-amber-950 text-amber-200">Maple Classic</option>
                            <option value="moss" class="bg-emerald-950 text-emerald-300">Maple Forest</option>
                            <option value="cyber" class="bg-purple-950 text-fuchsia-300">Maple Cyber</option>
                            <option value="crimson" class="bg-rose-950 text-rose-300">Maple Crimson</option>
                        </select>
                    </div>

                    <button onclick="exportData()" class="ms-button ms-inner-box px-3 py-1.5 rounded-lg text-xs md:text-sm font-semibold flex items-center gap-1.5">
                        <i class="fa-solid fa-download text-pink-500"></i> Export
                    </button>
                    <label class="ms-button ms-inner-box px-3 py-1.5 rounded-lg text-xs md:text-sm font-semibold cursor-pointer flex items-center gap-1.5">
                        <i class="fa-solid fa-upload text-pink-500"></i> Import
                        <input type="file" id="importFileInput" onchange="importData(event)" class="hidden" accept=".json">
                    </label>
                    <button onclick="resetCurrentSessionData()" class="ms-button ms-inner-box px-3.5 py-1.5 rounded-lg text-xs md:text-sm font-semibold flex items-center gap-2 text-rose-500 hover:text-rose-600">
                        <i class="fa-solid fa-rotate-left"></i> Reset Session
                    </button>
                </div>
            </div>
        </header>

        <!-- Banner Alert / Quick Info Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Map & Session Info Card -->
            <div class="ms-card rounded-xl p-4 flex flex-col justify-between shadow-md">
                <div class="flex items-center justify-between mb-2">
                    <label class="text-xs font-bold uppercase tracking-wider theme-subtext flex items-center gap-1.5">
                        <i class="fa-solid fa-map-location-dot text-pink-500"></i> Grind Location
                    </label>
                    <span id="levelDisplayTag" class="text-xs font-mono px-2 py-0.5 rounded ms-inner-box font-bold">Lv. 1</span>
                </div>
                <div class="space-y-2">
                    <!-- Location Dropdown Select -->
                    <select id="mapLocationSelect" onchange="handleLocationSelectChange(this)" class="w-full ms-inner-box rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-pink-500 font-medium transition cursor-pointer">
                        <optgroup label="Victoria Island">
                            <option value="Victoria Road : Henesys">Henesys</option>
                            <option value="Victoria Road : Ellinia">Ellinia</option>
                            <option value="Victoria Road : Kerning City">Kerning City</option>
                            <option value="Victoria Road : Perion">Perion</option>
                            <option value="Victoria Road : Lith Harbor">Lith Harbor</option>
                            <option value="Victoria Road : Sleepywood">Sleepywood / Ant Tunnel</option>
                            <option value="CUSTOM">-- Custom Location Input --</option>
                        </optgroup>
                    </select>

                    <input type="text" id="mapNameInput" value="Victoria Road : Henesys Hunting Ground I" placeholder="e.g. Victoria Road : Custom Training Map" class="hidden w-full ms-inner-box rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-pink-500 font-medium transition mt-1" oninput="saveCurrentState()">
                    <div class="flex gap-2">
                        <div class="w-1/2">
                            <label class="text-[10px] theme-subtext font-semibold block mb-0.5">CHARACTER LEVEL</label>
                            <input type="number" id="charLevelInput" value="1" min="1" max="100" class="w-full ms-inner-box rounded-lg px-2.5 py-1 text-xs font-mono focus:outline-none focus:border-pink-500" oninput="updateCalculations(); saveCurrentState();">
                        </div>
                        <div class="w-1/2 hidden">
                            <label class="text-[10px] theme-subtext font-semibold block mb-0.5">DROP / MESO %</label>
                            <div class="flex gap-1">
                                <input type="number" id="dropRateInput" value="200" placeholder="Drop%" class="w-full ms-inner-box rounded-lg px-2 py-1 text-xs font-mono focus:outline-none focus:border-pink-500" title="Drop Rate %" oninput="saveCurrentState()">
                                <input type="number" id="mesoRateInput" value="100" placeholder="Meso%" class="w-full ms-inner-box rounded-lg px-2 py-1 text-xs font-mono focus:outline-none focus:border-pink-500" title="Meso Rate %" oninput="saveCurrentState()">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PROMINENT PROFIT STATUS BANNER (Meso Positive Badge) -->
            <div id="profitBannerCard" class="ms-card rounded-xl p-4 flex flex-col justify-between relative overflow-hidden transition-all duration-300 shadow-md border-2 border-emerald-500/50">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider theme-subtext flex items-center gap-1.5">
                        <i class="fa-solid fa-scale-balanced text-pink-500"></i> Profitability Status
                    </span>
                    <span id="profitBadge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 border border-emerald-300 flex items-center gap-1">
                        <i class="fa-solid fa-circle-check"></i> MESO POSITIVE
                    </span>
                </div>
                <div class="my-2">
                    <div class="text-xs theme-subtext mb-0.5">Net Profit / Loss</div>
                    <div id="netProfitAmount" class="text-3xl font-extrabold font-mono text-emerald-500 tracking-tight">
                        +0 <span class="text-xs font-normal opacity-70">mesos</span>
                    </div>
                </div>
                <div class="flex items-center justify-between border-t border-slate-300/30 pt-2 text-xs">
                    <span class="theme-subtext">Net Rate / Min:</span>
                    <span id="netProfitHourly" class="font-mono font-bold text-emerald-600">+0 / min</span>
                </div>
            </div>

            <!-- EXP & Level Projections Quick View -->
            <div class="ms-card rounded-xl p-4 flex flex-col justify-between shadow-md">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider theme-subtext flex items-center gap-1.5">
                        <i class="fa-solid fa-chart-line text-pink-500"></i> Leveling Pace & ETA
                    </span>
                    <span class="text-xs text-pink-500 font-mono font-bold" id="expRateDisplay">0.00% / min</span>
                </div>
                <div class="my-2 space-y-1">
                    <div class="flex justify-between text-xs">
                        <span class="theme-subtext">EXP Gained:</span>
                        <span id="expGainedText" class="font-mono font-bold text-emerald-500">+0.000%</span>
                    </div>
                    <div class="w-full ms-inner-box h-2.5 rounded-full overflow-hidden">
                        <div id="expProgressBar" class="bg-gradient-to-r from-pink-400 to-rose-500 h-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>
                <div class="flex items-center justify-between border-t border-slate-300/30 pt-2 text-xs">
                    <span class="theme-subtext">Est. Time to Level Up:</span>
                    <span id="etaToLevel" class="font-mono font-bold text-pink-500">--h --m</span>
                </div>
            </div>
        </div>

        <!-- Middle Row: Main Session Controls & Trackers -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- LEFT COLUMN: Grind Session Timer (5 cols) -->
            <div class="lg:col-span-5 ms-card rounded-xl p-6 flex flex-col justify-between space-y-6 shadow-xl">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-base font-bold font-header flex items-center gap-2">
                            <i class="fa-solid fa-stopwatch text-pink-500"></i> Session Timer
                        </h2>
                        <div class="flex items-center gap-2">
                            <span id="timerStatusDot" class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
                            <span id="timerStatusText" class="text-xs font-mono uppercase theme-subtext font-bold">Stopped</span>
                        </div>
                    </div>

                    <!-- Main Timer Clock Display -->
                    <div class="ms-inner-box rounded-2xl p-6 text-center relative overflow-hidden group">
                        <div class="absolute -right-10 -bottom-10 opacity-5 text-9xl font-black select-none pointer-events-none">
                            <i class="fa-solid fa-clock"></i>
                        </div>
                        <div id="timerDisplay" class="text-5xl sm:text-6xl font-black font-mono tracking-wider text-pink-500 drop-shadow-sm">
                            00:00:00
                        </div>
                        <div class="text-xs theme-subtext font-mono mt-2 flex justify-center gap-4">
                            <span>Target: <strong class="text-current">Open-ended</strong></span>
                            <span>|</span>
                            <span>Elapsed: <strong id="elapsedTotalText" class="text-current">0s</strong></span>
                        </div>
                    </div>

                    <!-- Quick Preset Buttons -->
                    <div class="mt-4">
                        <label class="text-[10px] font-bold uppercase tracking-wider theme-subtext block mb-2">Timer Presets (Totem / Buff Duration)</label>
                        <div class="grid grid-cols-4 gap-2">
                            <button onclick="setTimerPreset(15)" class="ms-button ms-inner-box py-1.5 rounded-lg text-xs font-mono font-semibold hover:text-pink-600 transition">15m</button>
                            <button onclick="setTimerPreset(30)" class="ms-button ms-inner-box py-1.5 rounded-lg text-xs font-mono font-semibold hover:text-pink-600 transition">30m</button>
                            <button onclick="setTimerPreset(60)" class="ms-button ms-inner-box py-1.5 rounded-lg text-xs font-mono font-semibold hover:text-pink-600 transition">1 Hour</button>
                            <button onclick="setTimerPreset(120)" class="ms-button ms-inner-box py-1.5 rounded-lg text-xs font-mono font-semibold hover:text-pink-600 transition">2 Hours</button>
                        </div>
                    </div>
                </div>

                <!-- Timer Controls -->
                <div class="space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <button id="startPauseBtn" onclick="toggleTimer()" class="w-full py-3 px-4 rounded-xl font-bold text-sm bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-400 hover:to-rose-400 text-white transition shadow-lg flex items-center justify-center gap-2">
                            <i class="fa-solid fa-play" id="startPauseIcon"></i>
                            <span id="startPauseLabel">Start Session</span>
                        </button>
                        <button onclick="stopAndSaveSession()" class="w-full py-3 px-4 rounded-xl font-bold text-sm bg-amber-400 hover:bg-amber-300 text-slate-950 transition shadow-lg flex items-center justify-center gap-2">
                            <i class="fa-solid fa-box-archive"></i>
                            <span>Finish & Save</span>
                        </button>
                    </div>
                    <button onclick="resetTimerOnly()" class="w-full py-2 px-3 rounded-lg text-xs font-semibold theme-subtext hover:text-pink-600 transition flex items-center justify-center gap-1">
                        <i class="fa-solid fa-arrows-rotate"></i> Reset Timer Clock
                    </button>
                </div>
            </div>

            <!-- RIGHT COLUMN: EXP & Meso Numerical Inputs (7 cols) -->
            <div class="lg:col-span-7 space-y-6">

                <!-- EXP Tracker Panel -->
                <div class="ms-card rounded-xl p-5 space-y-4 shadow-md">
                    <div class="flex items-center justify-between border-b border-slate-300/30 pb-3">
                        <h3 class="text-sm font-bold font-header flex items-center gap-2">
                            <i class="fa-solid fa-bolt text-pink-500"></i> Experience (EXP) Tracker
                        </h3>
                        <span id="expInputModeHint" class="text-xs theme-subtext font-semibold text-amber-500">Ready to enter starting EXP</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="text-xs theme-subtext font-semibold mb-1 block">STARTING EXP (%)</label>
                            <input type="number" step="0.001" id="startExpInput" value="0.000" min="0" max="100" class="w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono focus:outline-none focus:border-pink-500 transition" oninput="updateCalculations(); saveCurrentState();">
                        </div>
                        <div>
                            <label id="endExpLabelText" class="text-xs theme-subtext font-semibold mb-1 block">CURRENT / ENDING EXP (%)</label>
                            <input type="number" step="0.001" id="endExpInput" value="0.000" min="0" max="100" class="w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono text-pink-500 font-bold focus:outline-none focus:border-pink-500 transition bg-slate-500/10 cursor-not-allowed" disabled placeholder="Pause timer to enter current EXP" oninput="updateCalculations(); saveCurrentState();">
                        </div>
                    </div>
                    <!-- Calculated Stat Cards -->
                    <div class="grid grid-cols-2 gap-3 pt-1">
                        <div class="ms-inner-box p-3 rounded-lg">
                            <div class="text-[11px] theme-subtext">Total EXP Gained</div>
                            <div id="statTotalExp" class="text-lg font-bold font-mono text-emerald-500">+0.000%</div>
                        </div>
                        <div class="ms-inner-box p-3 rounded-lg">
                            <div class="text-[11px] theme-subtext">Projected EXP / Min</div>
                            <div id="statExpPerHour" class="text-lg font-bold font-mono text-pink-500">0.00% / min</div>
                        </div>
                    </div>
                </div>

                <!-- Meso Tracker Panel -->
                <div class="ms-card rounded-xl p-5 space-y-4 shadow-md">
                    <div class="flex items-center justify-between border-b border-slate-300/30 pb-3">
                        <h3 class="text-sm font-bold font-header flex items-center gap-2">
                            <i class="fa-solid fa-coins text-pink-500"></i> Raw Meso Loot Tracker
                        </h3>
                        <div class="flex items-center gap-2">
                            <label class="text-xs theme-subtext">Quick Input Mode:</label>
                            <select id="mesoInputMode" onchange="toggleMesoInputMode()" class="ms-inner-box rounded px-2 py-0.5 text-xs text-pink-500 font-bold">
                                <option value="diff">Start & End Balance</option>
                                <option value="direct">Direct Total Picked Up</option>
                            </select>
                        </div>
                    </div>

                    <!-- Mode A: Start & End Mesos -->
