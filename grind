                        </div>
                        <div class="ms-inner-box p-3 rounded-lg">
                            <div class="text-[11px] theme-subtext">Gross Meso / Min</div>
                            <div id="statMesoPerHour" class="text-lg font-bold font-mono text-pink-500">0 / min</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Bottom Row: Consumables Costs & Extra Drops Value -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- Consumables Tracker Card -->
            <div class="ms-card rounded-xl p-5 space-y-4 flex flex-col justify-between shadow-md">
                <div>
                    <div class="flex items-center justify-between border-b border-slate-300/30 pb-3 mb-4">
                        <h3 class="text-sm font-bold font-header flex items-center gap-2">
                            <i class="fa-solid fa-flask text-rose-500"></i> Consumables & Buff Expenses
                        </h3>
                        <span id="totalConsumableCostTag" class="text-xs font-mono font-bold text-rose-500 px-2.5 py-1 rounded bg-rose-100 border border-rose-300">
                            Total Cost: 0 Meso
                        </span>
                    </div>

                    <p class="text-xs theme-subtext mb-3">Check active buffs/items or add custom costs used during session:</p>

                    <!-- Presets Grid -->
                    <div class="space-y-2 max-h-60 overflow-y-auto pr-1" id="consumablesList">
                        <!-- Dynamic Consumable Items render here -->
                    </div>
                </div>

                <!-- Custom Consumable Add Form -->
                <div class="pt-3 border-t border-slate-300/30">
                    <div class="text-xs font-bold theme-subtext mb-2">Add Custom Consumable / Cost:</div>
                    <div class="grid grid-cols-12 gap-2">
                        <input type="text" id="customConsumableName" placeholder="e.g. Exp Coupon 3x" class="col-span-5 ms-inner-box rounded px-2.5 py-1.5 text-xs focus:outline-none focus:border-pink-500">
                        <input type="number" id="customConsumableQty" placeholder="Qty" min="1" class="col-span-2 ms-inner-box rounded px-2 py-1.5 text-xs font-mono focus:outline-none focus:border-pink-500">
                        <input type="text" id="customConsumableCost" placeholder="Unit Cost" class="col-span-3 ms-inner-box rounded px-2 py-1.5 text-xs font-mono focus:outline-none focus:border-pink-500" oninput="formatMesoInput(this)">
                        <button onclick="addCustomConsumable()" class="col-span-2 ms-button bg-pink-500 text-white rounded text-xs font-bold hover:bg-pink-400 transition flex items-center justify-center">
                            <i class="fa-solid fa-plus"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Valuable Drops & Extra Loot Card -->
            <div class="ms-card rounded-xl p-5 space-y-4 flex flex-col justify-between shadow-md">
                <div>
                    <div class="flex items-center justify-between border-b border-slate-300/30 pb-3 mb-4">
                        <h3 class="text-sm font-bold font-header flex items-center gap-2">
                            <i class="fa-solid fa-gem text-purple-500"></i> Valuable Drops & Extra Revenue
                        </h3>
                        <span id="totalDropsValueTag" class="text-xs font-mono font-bold text-purple-600 px-2.5 py-1 rounded bg-purple-100 border border-purple-300">
                            Drops Value: 0 Meso
                        </span>
                    </div>

                    <p class="text-xs theme-subtext mb-3">Track tradeable items dropped and set market values to add to revenue:</p>

                    <!-- Drops Grid -->
                    <div class="space-y-2 max-h-60 overflow-y-auto pr-1" id="dropsList">
                        <!-- Dynamic Drops render here -->
                    </div>
                </div>

                <!-- Custom Drop Add Form -->
                <div class="pt-3 border-t border-slate-300/30">
                    <div class="text-xs font-bold theme-subtext mb-2">Add Custom Drop Item:</div>
                    <div class="grid grid-cols-12 gap-2">
                        <input type="text" id="customDropName" placeholder="e.g. Familiar Card" class="col-span-5 ms-inner-box rounded px-2.5 py-1.5 text-xs focus:outline-none focus:border-pink-500">
                        <input type="number" id="customDropQty" placeholder="Qty" min="1" class="col-span-2 ms-inner-box rounded px-2 py-1.5 text-xs font-mono focus:outline-none focus:border-pink-500">
                        <input type="text" id="customDropValue" placeholder="Vendor Price" class="col-span-3 ms-inner-box rounded px-2 py-1.5 text-xs font-mono focus:outline-none focus:border-pink-500" oninput="formatMesoInput(this)">
                        <button onclick="addCustomDrop()" class="col-span-2 ms-button bg-purple-600 text-white rounded text-xs font-bold hover:bg-purple-500 transition flex items-center justify-center">
