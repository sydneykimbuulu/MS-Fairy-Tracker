                        <input type="text" id="directMesoInput" value="0" class="w-full ms-inner-box rounded-lg px-3 py-2 text-sm font-mono text-pink-500 font-bold focus:outline-none focus:border-pink-500 transition bg-slate-500/10 cursor-not-allowed" disabled oninput="formatMesoInput(this); updateCalculations(); saveCurrentState();">
                    </div>

